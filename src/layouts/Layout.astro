---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	lang?: string;
	alternates?: { hreflang: string; href: string }[];
}

const {
	title = 'Screenshot Text Editor — Free Online AI Image Text Editor',
	description = 'Edit text in any screenshot or image online with our free AI screenshot text editor. Matches font, size, weight, and color — no watermark, no signup required.',
	keywords = 'screenshot text editor, screenshot text editor online, screenshot text editor ai, screenshot text editor ai free, screenshot text editor free, screenshot editor, screenshot editor online, screenshot editor ai, ai screenshot editor, image text editor, image text editor online, ai image text editor, free online image text editor, online text editor',
	ogImage = '/og-image.png',
	lang = 'en',
	alternates = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://screenshottexteditor.com');
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://screenshottexteditor.com');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="ScreenshotTextEditor" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(function () {
				document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
			})();
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalUrl} />
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ScreenshotTextEditor" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Roboto:wght@400;500;700&family=Noto+Sans:wght@400;700&display=swap"
			rel="stylesheet"
		/>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-B6DT4DMC2Q"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());

			gtag('config', 'G-B6DT4DMC2Q');
		</script>
	</head>
	<body class="h-full w-full m-0 bg-canvas text-ink">
		<slot />
	</body>
</html>
