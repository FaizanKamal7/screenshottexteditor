---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	/** Articles pass 'article'; everything else is a 'website'. */
	ogType?: 'website' | 'article';
	lang?: string;
	alternates?: { hreflang: string; href: string }[];
	/** Loads Inter / Roboto / Noto Sans too — only the editor's canvas and font picker use them. */
	editorFonts?: boolean;
	/** Error pages: emits robots noindex and drops the canonical/og:url, which would otherwise point at the error URL. */
	noindex?: boolean;
}

const {
	title = 'Screenshot Text Editor — Free Online AI Image Text Editor',
	description = 'Edit text in any screenshot or image online with our free AI screenshot text editor. Matches font, size, weight, and color — no watermark, no signup required.',
	ogImage = '/og-image.png',
	ogType = 'website',
	lang = 'en',
	alternates = [],
	editorFonts = false,
	noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const fontFamilies = ['Geist:wght@400;500;600;700', 'Geist+Mono:wght@400;500'];
if (editorFonts) fontFamilies.push('Inter:wght@400;500;600;700', 'Roboto:wght@400;500;700', 'Noto+Sans:wght@400;700');
const fontsHref = `https://fonts.googleapis.com/css2?${fontFamilies.map((family) => `family=${family}`).join('&')}&display=swap`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="ScreenshotTextEditor" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(function () {
				document.documentElement.classList.toggle('dark', localStorage.getItem('theme') === 'dark');
			})();
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
		{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="ScreenshotTextEditor" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Non-blocking: the stylesheet loads as `print` and flips to `all` once fetched, so text paints in the fallback font first (display=swap). -->
		<link href={fontsHref} rel="stylesheet" media="print" onload="this.media='all'" />
		<noscript><link href={fontsHref} rel="stylesheet" /></noscript>
		<!-- Google tag (gtag.js). The dataLayer stub queues events immediately; the ~175 KB library itself is injected on first interaction or 4s after load, so it never competes with first paint. -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-B6DT4DMC2Q');

			(function () {
				var loaded = false;
				function loadGtag() {
					if (loaded) return;
					loaded = true;
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=G-B6DT4DMC2Q';
					document.head.appendChild(s);
				}
				['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (type) {
					window.addEventListener(type, loadGtag, { once: true, passive: true });
				});
				window.addEventListener('load', function () {
					setTimeout(loadGtag, 4000);
				});
			})();
		</script>
	</head>
	<body class="h-full w-full m-0 bg-canvas text-ink">
		<slot />
	</body>
</html>
