---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Footer from '../components/Footer.astro';
import { EditorIsland } from '../editor/EditorIsland';

// The editor is server-rendered in its empty state (header + dropzone) and hydrated on load, so
// its full-viewport box is in the served HTML and the guide below never gets pushed down when
// React mounts (a client:only island rendered nothing until JS ran, which caused CLS ≈ 1.0).
// This guide is rendered on the server, below the editor, so the page carries real crawlable text.
const steps = [
	{
		title: '1. Upload an image',
		body: 'Drop a PNG or JPEG into the editor, or choose a file. Screenshots, UI mockups, marketing graphics, and dashboard exports all work, and no account is needed.',
	},
	{
		title: '2. Click the text to change',
		body: 'Every line of text is detected automatically. Click one, type your replacement, and the original font, size, weight, and color are matched for you. Each match shows a confidence score.',
	},
	{
		title: '3. Download the result',
		body: 'Everything outside the edited lines stays pixel-for-pixel the same. Export the finished image when you are happy with it. There is no visible watermark on the file.',
	},
];

// No WebApplication/SoftwareApplication JSON-LD here on purpose: Google (and Semrush) treat
// aggregateRating or review as required for that type, and there are no real ones to cite.
// Without them the markup earns no rich result and only shows up as an "invalid item" error.
---

<Layout
	title="Editor — ScreenshotTextEditor"
	description="Upload a screenshot, click any text and rewrite it in the editor. Font, size, weight and color are matched automatically, then download the result as a PNG."
	editorFonts
>
	<EditorIsland client:load />

	<section class="border-t border-hairline py-16">
		<Container class="max-w-4xl">
			<Eyebrow>Using the editor</Eyebrow>
			<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">Edit text in a screenshot in three steps.</h2>
			<div class="mt-8 grid gap-4 md:grid-cols-3">
				{steps.map((step) => <FeatureCard title={step.title}>{step.body}</FeatureCard>)}
			</div>

			<div class="mt-12 max-w-2xl space-y-4 text-[15px] leading-relaxed text-body">
				<h3 class="text-[18px] font-semibold tracking-tight text-ink">Tips for the best result</h3>
				<p>
					The editor works best on Latin-script text over flat or simple-gradient backgrounds, which is what most app and web
					screenshots use. If a font match looks off, open the layer for that line and override the font, weight, size, or color
					by hand. Made a mistake? Undo and redo with Ctrl+Z and Ctrl+Shift+Z (Cmd on a Mac).
				</p>
				<p>
					Busy photo backgrounds and CJK or right-to-left scripts aren't supported yet. In that case the tool will tell you how
					confident it is in each match instead of quietly producing an edit that looks wrong.
				</p>
				<p>
					Just want to know what font is used in an image, without editing anything? Try the
					<a href="/find-font-from-image/" class="text-link hover:underline">font finder</a>.
				</p>

				<h3 class="pt-4 text-[18px] font-semibold tracking-tight text-ink">Your uploads stay private</h3>
				<p>
					Uploaded images are deleted automatically, after one hour by default, and are never used to train models. Exports carry
					invisible content credentials that mark the image as edited, but nothing is stamped on the image itself. Read the
					<a href="/privacy/" class="text-link hover:underline">privacy policy</a> and the
					<a href="/terms/" class="text-link hover:underline">terms of service</a> for details, or
					<a href="/contact/" class="text-link hover:underline">get in touch</a> if something doesn't work the way it should.
				</p>
			</div>
		</Container>
	</section>

	<Footer />
</Layout>
