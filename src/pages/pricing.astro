---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';

const tiers = [
	{
		name: 'Free',
		price: '$0',
		period: '',
		description: 'Try it on a real screenshot before you commit to anything.',
		features: [
			'10 renders / month',
			'Single-image editor',
			'Confidence scoring & manual font override',
			'PNG and JPEG in, PNG out',
			'Uploads deleted after 1 hour',
		],
		cta: { label: 'Open the editor', href: '/app', variant: 'secondary' as const },
	},
	{
		name: 'Pro',
		price: '$19',
		period: '/ month',
		description: 'For teams shipping localized screenshots on a schedule.',
		features: [
			'Unlimited single-image edits',
			'CSV batch localization — upload once, export a ZIP per language',
			'Confidence scoring & manual font override',
			'Priority processing',
			'Everything in Free',
		],
		cta: { label: 'Start with Pro', href: '/app', variant: 'primary' as const },
		highlighted: true,
	},
	{
		name: 'Team',
		price: '$49',
		period: '/ seat / month',
		description: 'Shared batch jobs and priority support across a team.',
		features: [
			'Everything in Pro, per seat',
			'Shared batch localization jobs',
			'Priority support',
			'Early access to the API',
		],
		cta: { label: 'Talk to us', href: '/terms', variant: 'secondary' as const },
	},
];
---

<Layout title="Pricing — ScreenshotTextEditor" description="Simple pricing for screenshot text editing and App Store localization — from a free trial to team plans with batch CSV localization.">
	<Nav />

	<main>
		<section class="border-b border-hairline py-20">
			<Container class="max-w-2xl text-center">
				<Eyebrow>Pricing</Eyebrow>
				<h1 class="mt-3 text-[36px] font-semibold tracking-tight text-ink md:text-[44px]">
					Simple pricing, no surprise seats.
				</h1>
				<p class="mt-4 text-[15px] leading-relaxed text-body">
					Every tier gets the same deterministic pipeline and confidence scoring. Higher tiers unlock volume and the
					batch localization workflow. No tier ever removes the embedded content credentials on an export.
				</p>
			</Container>
		</section>

		<section class="py-20">
			<Container class="max-w-5xl">
				<div class="grid gap-6 md:grid-cols-3">
					{
						tiers.map((tier) => (
							<div
								class={`flex flex-col rounded-xl border p-7 ${
									tier.highlighted ? 'border-ink shadow-sm' : 'border-hairline'
								} bg-canvas-elevated`}
							>
								<p class="text-[15px] font-semibold text-ink">{tier.name}</p>
								<p class="mt-3 flex items-baseline gap-1">
									<span class="text-[34px] font-semibold tracking-tight text-ink">{tier.price}</span>
									<span class="text-[13px] text-mute">{tier.period}</span>
								</p>
								<p class="mt-2 text-[13px] leading-relaxed text-mute">{tier.description}</p>
								<ul class="mt-5 flex-1 space-y-2.5">
									{tier.features.map((feature) => (
										<li class="flex items-start gap-2 text-[13px] leading-relaxed text-body">
											<span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-ink" />
											{feature}
										</li>
									))}
								</ul>
								<div class="mt-6">
									<Button href={tier.cta.href} variant={tier.cta.variant} class="w-full">
										{tier.cta.label}
									</Button>
								</div>
							</div>
						))
					}
				</div>

				<div class="mt-14 rounded-xl border border-hairline bg-canvas-elevated p-6 text-[14px] text-body">
					<p class="font-semibold text-ink">What's not here yet</p>
					<p class="mt-2 leading-relaxed">
						Text over photos and complex textures, CJK and RTL scripts, gradient or stroked text, drop shadows, a
						Figma plugin, and a public API are all on the roadmap but not shipped in v1 — see the{' '}
						<a href="/terms" class="text-link hover:underline">terms</a> for the current scope.
					</p>
				</div>
			</Container>
		</section>
	</main>

	<Footer />
</Layout>
