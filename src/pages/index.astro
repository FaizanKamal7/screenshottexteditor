---
export const prerender = true;

import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import FeatureCard from '../components/FeatureCard.astro';
import MeshGradient from '../components/MeshGradient.astro';
import { EditorIsland } from '../editor/EditorIsland';

const useCases = await getCollection('useCases');

const steps = [
	{
		title: '1. Detect',
		body: 'OCR finds every text run at the line level, with per-character boxes and the image scale factor — 1x, 2x, or 3x — measured from the glyphs themselves.',
	},
	{
		title: '2. Match',
		body: 'Your original text is rendered in a short list of platform-likely fonts and scored against a real alpha mask until the closest font, size, weight, and spacing is found — with the score shown, not hidden.',
	},
	{
		title: '3. Rebuild',
		body: 'The old text is erased with a matching fill and your replacement is rendered at the same baseline and anti-aliasing, then re-verified against the original before it ships.',
	},
];
---

<Layout>
	<Nav />

	<main>
		<section class="relative overflow-hidden border-b border-hairline py-24 md:py-32">
			<MeshGradient />
			<Container class="max-w-3xl text-center">
				<Eyebrow>Pixel-accurate screenshot editing</Eyebrow>
				<h1 class="mt-4 text-[44px] font-semibold leading-[1.05] tracking-tight text-ink md:text-[56px] md:tracking-[-0.025em]">
					Edit text in a screenshot.<br /> Keep every other pixel exactly the same.
				</h1>
				<p class="mx-auto mt-5 max-w-xl text-[17px] leading-relaxed text-body">
					We detect every text run in a screenshot, match its font, size, weight, color, and anti-aliasing, then rebuild
					it — a result that survives a side-by-side comparison at 400% zoom.
				</p>
				<div class="mt-8 flex items-center justify-center gap-3">
					<Button href="/app" variant="primary">Open the editor</Button>
					<Button href="#demo" variant="secondary">See it work</Button>
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-4xl">
				<div class="grid gap-10 md:grid-cols-2 md:items-center">
					<div>
						<Eyebrow>Why this is different</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold leading-tight tracking-tight text-ink">
							A deterministic pipeline, not a generated guess.
						</h2>
						<p class="mt-3 text-[15px] leading-relaxed text-body">
							Most text-in-image tools lean on generative image models — great at photos and posters, unreliable on
							small, crisp UI text where every pixel of a letterform matters. We built the opposite: six discrete,
							testable stages that detect, measure, and reproduce the actual font rather than paint something
							plausible over it.
						</p>
						<p class="mt-3 text-[15px] leading-relaxed text-body">
							Every match carries a confidence score. If we can't reproduce your original text closely enough to
							trust the result, we tell you — instead of shipping an edit that looks wrong at a glance.
						</p>
					</div>
					<div class="rounded-xl border border-hairline bg-canvas-elevated p-6">
						<p class="font-mono text-xs uppercase tracking-wide text-faint">Match confidence</p>
						<div class="mt-4 space-y-3">
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">"Continue" — SF Pro fallback, 17px</span>
								<span class="h-2 w-2 rounded-full bg-link" title="high confidence" />
							</div>
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">"$48.20" — Inter, 14px</span>
								<span class="h-2 w-2 rounded-full bg-link" title="high confidence" />
							</div>
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">"Settings" — condensed, unmatched</span>
								<span class="h-2 w-2 rounded-full bg-warning" title="needs review" />
							</div>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-5xl">
				<Eyebrow>How it works</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">Detect, match, rebuild.</h2>
				<div class="mt-8 grid gap-4 md:grid-cols-3">
					{steps.map((step) => <FeatureCard title={step.title}>{step.body}</FeatureCard>)}
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-4xl">
				<div class="grid gap-10 md:grid-cols-2 md:items-center">
					<div>
						<Eyebrow>Built for</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold leading-tight tracking-tight text-ink">
							App Store & Play Store localization.
						</h2>
						<p class="mt-3 text-[15px] leading-relaxed text-body">
							Eight screenshots, twenty languages — today that means rebuilding every screenshot in Figma for every
							locale. Upload once, hand us a CSV of translations, and download a ZIP with every language rendered in
							the original font and layout, reflowed automatically when translated text runs long.
						</p>
						<div class="mt-5">
							<Button href="/localize-app-store-screenshots" variant="secondary">See how localization works →</Button>
						</div>
					</div>
					<div class="rounded-xl border border-hairline bg-canvas-elevated p-6">
						<p class="font-mono text-xs uppercase tracking-wide text-faint">screenshots_de.csv</p>
						<div class="mt-3 space-y-1.5 font-mono text-[12px] text-body">
							<p>region_id,en,de</p>
							<p>hero_title,"Get started","Loslegen"</p>
							<p>hero_sub,"Free forever","Für immer kostenlos"</p>
							<p>cta_button,"Try it now","Jetzt testen"</p>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<section id="demo" class="border-b border-hairline bg-hairline-soft/50 py-20">
			<Container class="max-w-4xl">
				<Eyebrow>Try it live</Eyebrow>
				<h2 class="mt-2 text-[26px] font-semibold tracking-tight text-ink">Drop in a screenshot.</h2>
				<p class="mt-2 text-[14px] text-mute">
					This is the real editor, running against the live pipeline — not a mockup.
				</p>
				<div class="mt-6">
					<EditorIsland client:only="react" embedded />
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-3xl">
				<Eyebrow>Privacy</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">Your screenshots aren't the product.</h2>
				<p class="mt-3 text-[15px] leading-relaxed text-body">
					Screenshots often carry account data, customer names, or internal numbers. Uploads are deleted automatically
					— one hour by default — and we never train on user images. Every export also carries embedded content
					credentials marking it as edited, so an edited screenshot never quietly passes as an original.
				</p>
				<div class="mt-5">
					<Button href="/privacy" variant="ghost">Read the privacy policy →</Button>
				</div>
			</Container>
		</section>

		<section id="use-cases" class="border-b border-hairline py-20">
			<Container class="max-w-5xl">
				<Eyebrow>Use cases</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">One pipeline, every screenshot.</h2>
				<div class="mt-8 grid gap-4 md:grid-cols-3">
					{
						useCases.map((useCase) => (
							<a
								href={`/${useCase.id}`}
								class="rounded-xl border border-hairline bg-canvas-elevated p-6 transition-colors hover:border-ink/20"
							>
								<p class="font-mono text-xs uppercase tracking-wide text-faint">{useCase.data.eyebrow}</p>
								<p class="mt-2 text-[15px] font-semibold text-ink">{useCase.data.title}</p>
								<p class="mt-2 text-[13px] leading-relaxed text-mute">{useCase.data.metaDescription}</p>
							</a>
						))
					}
				</div>
			</Container>
		</section>

		<section class="py-24">
			<Container class="max-w-3xl text-center">
				<h2 class="text-[32px] font-semibold tracking-tight text-ink">Try it on your own screenshot.</h2>
				<p class="mt-3 text-[15px] text-body">No account needed to try it. Deleted automatically after an hour.</p>
				<div class="mt-7">
					<Button href="/app" variant="primary">Open the editor</Button>
				</div>
			</Container>
		</section>
	</main>

	<Footer />
</Layout>
