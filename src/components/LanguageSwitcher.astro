---
import { languages, localizedPath, getTranslations, type TranslatableRouteKey } from '../i18n';

interface Props {
	lang: string;
	/** The current page's translatable route key, or null if this page has no translated version (it only exists in English). */
	routeKey: TranslatableRouteKey | null;
	class?: string;
}

const { lang, routeKey, class: className = '' } = Astro.props;
const t = getTranslations(lang);

function hrefFor(code: string): string {
	return localizedPath(code, routeKey ?? '');
}
---

<details class:list={['group relative', className]}>
	<summary class="nav-icon-btn" aria-label={t.languageSwitcher.ariaLabel}>
		<svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M2 12h20"></path>
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
		</svg>
	</summary>
	<div class="nav-popover right-0 top-full mt-2 max-h-80 w-48 overflow-y-auto p-1.5">
		{
			languages.map((l) => (
				<a href={hrefFor(l.code)} data-lang-link={l.code} class="lang-item" aria-current={l.code === lang ? 'true' : undefined}>
					<span>{l.flag}</span>
					<span>{l.nativeLabel}</span>
				</a>
			))
		}
	</div>
</details>

<script>
	(function () {
		document.querySelectorAll('[data-lang-link]').forEach((el) => {
			el.addEventListener('click', () => {
				const code = el.getAttribute('data-lang-link');
				if (!code) return;
				document.cookie = `pref_lang=${code}; path=/; max-age=${60 * 60 * 24 * 365}; samesite=lax`;
			});
		});
	})();
</script>
