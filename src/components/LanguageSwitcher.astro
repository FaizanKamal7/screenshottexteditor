---
import { languages, localizedPath, getTranslations, type TranslatableRouteKey } from '../i18n';

interface Props {
	lang: string;
	/** The current page's translatable route key, or null if this page has no translated version (it only exists in English). */
	routeKey: TranslatableRouteKey | null;
	class?: string;
}

const { lang, routeKey, class: className = '' } = Astro.props;
const t = getTranslations(lang);
const current = languages.find((l) => l.code === lang) ?? languages[0];

function hrefFor(code: string): string {
	return localizedPath(code, routeKey ?? '');
}
---

<details class:list={['group relative', className]}>
	<summary
		class="flex list-none cursor-pointer items-center gap-1.5 rounded-full px-2.5 py-1.5 text-[13px] text-body transition-colors hover:bg-hairline-soft hover:text-ink [&::-webkit-details-marker]:hidden"
		aria-label={t.languageSwitcher.ariaLabel}
	>
		<svg
			class="h-[16px] w-[16px] shrink-0"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<circle cx="12" cy="12" r="10"></circle>
			<path d="M2 12h20"></path>
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"></path>
		</svg>
		<span class="hidden sm:inline">{current.flag} {current.nativeLabel}</span>
	</summary>
	<div class="absolute right-0 top-full z-30 mt-2 max-h-80 w-48 overflow-y-auto rounded-lg border border-hairline bg-canvas-elevated p-1.5 shadow-lg">
		{
			languages.map((l) => (
				<a
					href={hrefFor(l.code)}
					class:list={[
						'flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[13px] transition-colors hover:bg-hairline-soft',
						l.code === lang ? 'font-medium text-ink' : 'text-body',
					]}
				>
					<span>{l.flag}</span>
					<span>{l.nativeLabel}</span>
				</a>
			))
		}
	</div>
</details>
