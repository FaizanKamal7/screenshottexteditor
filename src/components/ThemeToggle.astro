---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	aria-label="Toggle dark mode"
	class:list={[
		'inline-flex h-8 w-8 items-center justify-center rounded-full text-body transition-colors hover:bg-hairline-soft hover:text-ink',
		className,
	]}
>
	<svg class="theme-toggle-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
	</svg>
	<svg class="theme-toggle-moon hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		if (window.__themeToggleInit) return;
		window.__themeToggleInit = true;

		function sync() {
			var isDark = document.documentElement.classList.contains('dark');
			document.querySelectorAll('.theme-toggle-sun').forEach(function (el) {
				el.classList.toggle('hidden', isDark);
			});
			document.querySelectorAll('.theme-toggle-moon').forEach(function (el) {
				el.classList.toggle('hidden', !isDark);
			});
		}

		document.addEventListener('click', function (e) {
			var button = e.target.closest('[data-theme-toggle]');
			if (!button) return;
			var isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			sync();
		});

		sync();
	})();
</script>
