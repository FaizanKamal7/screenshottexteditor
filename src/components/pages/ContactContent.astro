---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import FeatureCard from '../FeatureCard.astro';
import { getTranslations, getAlternateLinks } from '../../i18n';

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const channels = [
	{ ...t.contact.supportChannel, email: 'support@screenshottexteditor.com' },
	{ ...t.contact.privacyChannel, email: 'privacy@screenshottexteditor.com' },
	{ ...t.contact.legalChannel, email: 'legal@screenshottexteditor.com' },
];
---

<Layout title={t.contact.metaTitle} description={t.contact.metaDescription} lang={lang} alternates={getAlternateLinks('contact')}>
	<Nav lang={lang} routeKey="contact" />

	<main>
		<section class="border-b border-hairline py-16">
			<Container class="max-w-2xl">
				<Eyebrow>{t.contact.eyebrow}</Eyebrow>
				<h1 class="mt-3 text-[32px] font-semibold tracking-tight text-ink">{t.contact.title}</h1>
				<p class="mt-3 text-[15px] leading-relaxed text-body">
					{t.contact.subtitle}
				</p>
			</Container>
		</section>

		<section class="py-16">
			<Container class="max-w-4xl">
				<div class="grid gap-4 md:grid-cols-3">
					{
						channels.map((channel) => (
							<FeatureCard title={channel.title}>
								<p>{channel.body}</p>
								<a href={`mailto:${channel.email}`} class="mt-3 inline-block text-[13px] font-medium text-link hover:underline">
									{channel.email}
								</a>
							</FeatureCard>
						))
					}
				</div>

				<p class="mt-10 text-[14px] leading-relaxed text-mute">
					{t.contact.footerNote}
				</p>
			</Container>
		</section>
	</main>

	<Footer lang={lang} />
</Layout>
