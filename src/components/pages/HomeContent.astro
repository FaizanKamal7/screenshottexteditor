---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import LocaleRedirect from '../LocaleRedirect.astro';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import FeatureCard from '../FeatureCard.astro';
import MeshGradient from '../MeshGradient.astro';
import { AnimatedEditorDemo } from '../demo/AnimatedEditorDemo';
import { getTranslations, localizedPath, getAlternateLinks, languages } from '../../i18n';
import { isCjk, spaceBefore, spaceAfter } from '../../i18n/format';

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const cjk = isCjk(lang);

const aboutHref = localizedPath(lang, 'about');
const contactHref = localizedPath(lang, 'contact');
const privacyHref = '/privacy/';
const termsHref = '/terms/';
const p5End = cjk ? '。' : '.';

const useCases = await getCollection('useCases');

const isEn = lang === 'en';

// English-only supplemental FAQ entries answering common "screenshot text editor"
// search intent not already covered by t.home.faqs. Kept out of the shared
// Translations so other locales aren't expected to mirror them — these extend
// the English page only.
const enExtraFaqs: { question: string; answer: string }[] = isEn
	? [
			{
				question: 'Can I edit text in a PNG?',
				answer:
					'Yes — PNG is one of the two supported formats. Upload your PNG screenshot, click the text you want to change, and download the result as a PNG.',
			},
			{
				question: 'Can I edit text in a JPEG or JPG screenshot?',
				answer:
					'Yes — JPEG and JPG screenshots are supported the same way as PNG. Upload the file, replace the text you need, and export it back out as a JPG.',
			},
			{
				question: 'Does ScreenshotTextEditor preserve the original font?',
				answer:
					'It tries to. Your text is rendered in a shortlist of likely fonts and scored against the real pixels to find the closest match for family, size, weight, and spacing — with a confidence score shown, not hidden.',
			},
			{
				question: 'Do I need to install software?',
				answer: "No. It runs entirely in your browser — there's nothing to download or install, and no design software required.",
			},
			{
				question: 'Are my screenshots private?',
				answer: 'Yes. We never train on user images, and uploads are not kept — see the privacy section above for how long they are stored.',
			},
			{
				question: 'Can I edit screenshots from iPhone and Android?',
				answer:
					'Yes. The editor runs online, so you can upload directly from an iPhone or Android device and download the edited screenshot back to it.',
			},
			{
				question: 'What happens if the original font cannot be matched?',
				answer:
					"If a font can't be matched with high confidence, the closest match found is still used, but it's flagged as low-confidence instead of presented as an exact match, so you can judge the result before downloading it.",
			},
			{
				question: 'How do I make text in a screenshot editable?',
				answer:
					'Upload your screenshot and optical character recognition (OCR) detects each line of text, turning it into editable text you can click. Select the line you want to change, type the new wording, and download the edited image.',
			},
			{
				question: 'How do I remove text from a screenshot without leaving a mark?',
				answer:
					"Click the line of text, delete its contents, and apply the edit. The area behind the old text is filled to match the surrounding background, so there's no visible patch or blur. This works best on flat and simple-gradient backgrounds; busy photo backgrounds aren't supported yet.",
			},
			{
				question: 'Can I change the color or font of text in a screenshot?',
				answer:
					"Yes. The original font, weight, size, and color are matched automatically, and you can override the font family, weight, size, letter spacing, color, and alignment in the style panel if you want a different look.",
			},
			{
				question: 'Can I change just one word in a line?',
				answer:
					'Yes. Text is detected line by line, so click the line, change only the word you need, and leave the rest as it is. The whole line is re-rendered in the matched font, so the unchanged words stay consistent with the new one.',
			},
			{
				question: 'What image formats and file sizes are supported?',
				answer:
					"PNG and JPEG/JPG are supported. Other formats such as WEBP, HEIC, or PDF aren't supported yet, so convert them to PNG first. Standard phone and desktop screenshots, including 2x and 3x Retina captures, are handled at their original resolution.",
			},
		]
	: [];

const faqPage = {
	'@type': 'FAQPage',
	mainEntity: [...t.home.faqs, ...enExtraFaqs].map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};

// Site-level entities belong on the domain homepage only (Google reads site name and logo from
// there), so the localized homepages carry just their own FAQPage.
const siteUrl = 'https://screenshottexteditor.com';
const siteEntities = isEn
	? [
			{
				'@type': 'Organization',
				'@id': `${siteUrl}/#organization`,
				name: 'ScreenshotTextEditor',
				url: `${siteUrl}/`,
				logo: `${siteUrl}/icon.png`,
				email: 'support@screenshottexteditor.com',
			},
			{
				'@type': 'WebSite',
				'@id': `${siteUrl}/#website`,
				name: 'ScreenshotTextEditor',
				alternateName: 'Screenshot Text Editor',
				url: `${siteUrl}/`,
				inLanguage: languages.map((l) => l.code),
				publisher: { '@id': `${siteUrl}/#organization` },
			},
		]
	: [];

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [...siteEntities, faqPage],
};
---

<Layout title={t.home.metaTitle} description={t.home.metaDescription} lang={lang} alternates={getAlternateLinks('')}>
	<LocaleRedirect lang={lang} routeKey="" />
	<Nav lang={lang} routeKey="" />

	<main>
		<section class="relative border-b border-hairline pb-16 pt-20 md:pb-24 md:pt-28">
			<MeshGradient />
			<Container class="max-w-7xl">
				<div class="lg:grid lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-8">
					<div class="mx-auto max-w-2xl text-center lg:mx-0 lg:max-w-none lg:text-left">
						<Eyebrow>{t.home.heroEyebrow}</Eyebrow>
						<h1 class="mt-4 text-[36px] font-semibold leading-[1.08] tracking-tight text-ink md:text-[48px] md:tracking-[-0.025em]">
							{t.home.heroTitleLine1}<br /> {t.home.heroTitleLine2}
						</h1>
						<p class="mx-auto mt-4 max-w-xl text-[16px] leading-relaxed text-body md:text-[17px] lg:mx-0">
							{t.home.heroSubtitle}
						</p>
						<div class="mt-7 flex items-center justify-center gap-3 lg:justify-start">
							<Button href="/app" variant="primary">{t.home.ctaPrimary}</Button>
							<Button href="/app" variant="secondary">{t.home.ctaSecondary}</Button>
						</div>
						<p class="mt-4 text-center text-[13px] text-mute lg:text-left">{t.home.heroFreeNote}</p>
					</div>

					<div id="demo" class="relative z-10 mx-auto mt-12 flex justify-center -mb-16 md:mt-16 md:-mb-24 lg:mx-0 lg:mb-0 lg:mt-0">
						<AnimatedEditorDemo client:afterload />
					</div>
				</div>
			</Container>
		</section>

		{
			isEn && (
				<section class="border-b border-hairline py-20">
					<Container class="max-w-5xl">
						<Eyebrow>Getting started</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">How to edit text in a screenshot</h2>
						<p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-body">
							ScreenshotTextEditor replaces text that's already in your screenshot — it doesn't paint a new text box on
							top. Upload a <a href="/change-text-in-png/" class="text-link hover:underline">PNG</a> or JPEG/JPG
							screenshot and the background, icons, and layout around your text stay exactly as they were.
						</p>
						<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
							<FeatureCard title="1. Upload your screenshot">
								Drop in your screenshot or click to browse. Nothing to install, no design software.
							</FeatureCard>
							<FeatureCard title="2. Click the text you want to change">
								Every line of detected text is clickable — no need to trace a box or select pixels yourself.
							</FeatureCard>
							<FeatureCard title="3. Enter the replacement text">
								Type your new wording. The font, size, weight, and color are matched automatically.
							</FeatureCard>
							<FeatureCard title="4. Download the edited screenshot">
								Export a pixel-accurate PNG or JPG, ready to share.
							</FeatureCard>
						</div>
						<p class="mt-6 text-[14px] text-mute">
							It works the same on <a href="/edit-text-in-ios-screenshot/" class="text-link hover:underline">iPhone screenshots</a> and <a href="/edit-text-in-android-screenshot/" class="text-link hover:underline">Android screenshots</a>.
							For the manual method, common pitfalls, and when a full image editor is the better choice, read the guide to <a href="/blog/edit-text-in-screenshot/" class="text-link hover:underline">editing text in a screenshot without Photoshop</a>.
						</p>
						<div class="mt-5">
							<Button href="/app" variant="secondary">Open the screenshot editor</Button>
						</div>
					</Container>
				</section>
			)
		}

		{
			isEn && (
				<section class="border-b border-hairline py-20">
					<Container class="max-w-5xl">
						<Eyebrow>What you can do</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">Edit, remove, or replace text in a screenshot</h2>
						<p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-body">
							Every change is made to the text region only — icons, buttons, and the rest of the layout stay exactly as they were.
						</p>
						<div class="mt-8 grid gap-4 md:grid-cols-3">
							<FeatureCard title="Replace text">
								Click any line and type new wording. The original font, size, weight, and color are matched automatically, so
								the replacement looks like it was always there.
							</FeatureCard>
							<FeatureCard title="Remove text">
								Delete a line's contents and apply the edit. The area behind it is filled to match the surrounding background,
								with no visible patch or blur. Works best on flat and simple-gradient backgrounds.
							</FeatureCard>
							<FeatureCard title="Change text color">
								Pick a new text color in the style panel, or adjust the font, weight, size, letter spacing, and alignment when
								you want something other than the automatic match.
							</FeatureCard>
						</div>
					</Container>
				</section>
			)
		}

		<section class="border-b border-hairline py-20">
			<Container class="max-w-4xl">
				<div class="grid gap-10 md:grid-cols-2 md:items-center">
					<div>
						<Eyebrow>{t.home.diffEyebrow}</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold leading-tight tracking-tight text-ink">
							{t.home.diffTitle}
						</h2>
						<p class="mt-3 text-[15px] leading-relaxed text-body">{t.home.diffP1}</p>
						<p class="mt-3 text-[15px] leading-relaxed text-body">{t.home.diffP2}</p>
					</div>
					<div class="rounded-xl border border-hairline bg-canvas-elevated p-6">
						<p class="font-mono text-xs uppercase tracking-wide text-faint">{t.home.matchConfidenceLabel}</p>
						<div class="mt-4 space-y-3">
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">{t.home.matchItem1}</span>
								<span class="h-2 w-2 rounded-full bg-link" title={t.home.highConfidence} />
							</div>
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">{t.home.matchItem2}</span>
								<span class="h-2 w-2 rounded-full bg-link" title={t.home.highConfidence} />
							</div>
							<div class="flex items-center justify-between rounded-md border border-hairline px-3 py-2">
								<span class="text-[13px] text-body">{t.home.matchItem3}</span>
								<span class="h-2 w-2 rounded-full bg-warning" title={t.home.needsReview} />
							</div>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-5xl">
				<Eyebrow>{t.home.howEyebrow}</Eyebrow>
				{
					isEn ? (
						<>
							<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">How OCR detects the text in your screenshot</h2>
							<p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-body">
								ScreenshotTextEditor uses AI-powered OCR and font matching. Optical character recognition (OCR) reads the text
								from an image line by line and turns each line into editable text, so you can select the text you want to
								change instead of tracing a box around it. Font matching then works out exactly how that text was drawn, and
								the line is rebuilt with your replacement.
							</p>
						</>
					) : (
						<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">{t.home.howTitle}</h2>
					)
				}
				<div class="mt-8 grid gap-4 md:grid-cols-3">
					{t.home.steps.map((step) => <FeatureCard title={step.title}>{step.body}</FeatureCard>)}
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-4xl">
				<div class="grid gap-10 md:grid-cols-2 md:items-center">
					<div>
						<Eyebrow>{t.home.builtForEyebrow}</Eyebrow>
						<h2 class="mt-3 text-[26px] font-semibold leading-tight tracking-tight text-ink">
							{t.home.builtForTitle}
						</h2>
						<p class="mt-3 text-[15px] leading-relaxed text-body">{t.home.builtForP}</p>
						<div class="mt-5">
							<Button href="/localize-app-store-screenshots/" variant="secondary">{t.home.builtForCta}</Button>
						</div>
					</div>
					<div class="rounded-xl border border-hairline bg-canvas-elevated p-6">
						<p class="font-mono text-xs uppercase tracking-wide text-faint">{t.home.csvLabel}</p>
						<div class="mt-3 space-y-1.5 font-mono text-[12px] text-body">
							<p>region_id,en,de</p>
							<p>hero_title,"Get started","Loslegen"</p>
							<p>hero_sub,"Free forever","Für immer kostenlos"</p>
							<p>cta_button,"Try it now","Jetzt testen"</p>
						</div>
					</div>
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-3xl">
				<Eyebrow>{t.home.privacyEyebrow}</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">{t.home.privacyTitle}</h2>
				<p class="mt-3 text-[15px] leading-relaxed text-body">{t.home.privacyP}</p>
				<div class="mt-5 flex flex-wrap items-center gap-3">
					<Button href={privacyHref} variant="ghost">{t.home.privacyLink1}</Button>
					<Button href={termsHref} variant="ghost">{t.home.privacyLink2}</Button>
				</div>
			</Container>
		</section>

		<section id="use-cases" class="border-b border-hairline py-20">
			<Container class="max-w-5xl">
				<Eyebrow>{t.home.useCasesEyebrow}</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">{t.home.useCasesTitle}</h2>
				<div class="mt-8 grid gap-4 md:grid-cols-3">
					{
						useCases.map((useCase) => (
							<a
								href={`/${useCase.id}/`}
								class="rounded-xl border border-hairline bg-canvas-elevated p-6 transition-colors hover:border-ink/20"
							>
								<p class="font-mono text-xs uppercase tracking-wide text-faint">{useCase.data.eyebrow}</p>
								<h3 class="mt-2 text-[15px] font-semibold text-ink">{useCase.data.title}</h3>
								<p class="mt-2 text-[13px] leading-relaxed text-mute">{useCase.data.metaDescription}</p>
							</a>
						))
					}
					{
						lang === 'en' && (
							<a
								href="/find-font-from-image/"
								class="rounded-xl border border-hairline bg-canvas-elevated p-6 transition-colors hover:border-ink/20"
							>
								<p class="font-mono text-xs uppercase tracking-wide text-faint">Font finder</p>
								<h3 class="mt-2 text-[15px] font-semibold text-ink">Find Font from Image</h3>
								<p class="mt-2 text-[13px] leading-relaxed text-mute">
									Upload an image and find the closest matching font, free and without signup.
								</p>
							</a>
						)
					}
				</div>
			</Container>
		</section>

		<section class="border-b border-hairline py-20">
			<Container class="max-w-3xl">
				<Eyebrow>{t.home.aboutToolEyebrow}</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">{t.home.aboutToolTitle}</h2>
				<div class="mt-4 space-y-4 text-[15px] leading-relaxed text-body">
					<p>{t.home.aboutToolP1}</p>
					<p>{t.home.aboutToolP2}</p>
					<h3 class="text-[18px] font-semibold text-ink">{t.home.aboutToolH3a}</h3>
					<p>{t.home.aboutToolP3}</p>
					<h3 class="text-[18px] font-semibold text-ink">{t.home.aboutToolH3b}</h3>
					<p>{t.home.aboutToolP4}</p>
					<h3 class="text-[18px] font-semibold text-ink">{t.home.aboutToolH3c}</h3>
					<p>
						{t.home.aboutToolP5Pre}{spaceAfter(lang)}<a href={aboutHref} class="text-link hover:underline">{t.home.aboutToolP5LinkText}</a>{p5End}
					</p>
				</div>
			</Container>
		</section>

		<section id="faq" class="border-b border-hairline py-20">
			<Container class="max-w-3xl">
				<Eyebrow>{t.home.faqEyebrow}</Eyebrow>
				<h2 class="mt-3 text-[26px] font-semibold tracking-tight text-ink">{t.home.faqTitle}</h2>
				<div class="mt-6 space-y-3">
					{
						[...t.home.faqs, ...enExtraFaqs].map((faq) => (
							<details class="group rounded-xl border border-hairline bg-canvas-elevated p-5 open:pb-5">
								<summary class="-m-5 cursor-pointer list-none p-5 text-[15px] font-semibold text-ink [&::-webkit-details-marker]:hidden">
									<span class="flex items-center justify-between gap-4">
										{faq.question}
										<span class="shrink-0 text-faint transition-transform group-open:rotate-45">+</span>
									</span>
								</summary>
								<p class="mt-3 text-[14px] leading-relaxed text-body">{faq.answer}</p>
							</details>
						))
					}
				</div>
				<p class="mt-6 text-[14px] text-mute">
					{t.home.faqFooterPre}{spaceAfter(lang)}<a href={contactHref} class="text-link hover:underline">{t.home.faqFooterLinkText}</a>{spaceBefore(t.home.faqFooterPost, lang)}{t.home.faqFooterPost}
				</p>
			</Container>
		</section>

		<section class="py-24">
			<Container class="max-w-3xl text-center">
				<h2 class="text-[32px] font-semibold tracking-tight text-ink">{t.home.finalTitle}</h2>
				<p class="mt-3 text-[15px] text-body">{t.home.finalSubtitle}</p>
				<div class="mt-7">
					<Button href="/app" variant="primary">{t.home.finalCta}</Button>
				</div>
			</Container>
		</section>
	</main>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

	<Footer lang={lang} />
</Layout>
