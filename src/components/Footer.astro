---
import { getCollection } from 'astro:content';
import Container from './Container.astro';

const useCases = await getCollection('useCases');
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas">
	<Container class="grid gap-10 py-16 md:grid-cols-4">
		<div>
			<p class="text-[15px] font-semibold tracking-tight text-ink">ScreenshotTextEditor</p>
			<p class="mt-2 max-w-xs text-[13px] leading-relaxed text-mute">
				A deterministic pipeline for editing text in screenshots — pixel-indistinguishable from the original.
			</p>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">Product</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				<li><a href="/app" class="hover:text-ink">Open the editor</a></li>
				<li><a href="/pricing" class="hover:text-ink">Pricing</a></li>
				<li><a href="/#use-cases" class="hover:text-ink">Use cases</a></li>
			</ul>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">Use cases</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				{
					useCases.map((useCase) => (
						<li>
							<a href={`/${useCase.id}`} class="hover:text-ink">
								{useCase.data.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">Company</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				<li><a href="/privacy" class="hover:text-ink">Privacy</a></li>
				<li><a href="/terms" class="hover:text-ink">Terms</a></li>
			</ul>
		</div>
	</Container>

	<div class="border-t border-hairline">
		<Container class="py-4 text-[12px] text-faint">
			© {year} ScreenshotTextEditor. All exports carry embedded content credentials marking them as edited.
		</Container>
	</div>
</footer>
