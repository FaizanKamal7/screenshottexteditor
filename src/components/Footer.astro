---
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import { getTranslations, localizedPath } from '../i18n';

interface Props {
	lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const home = localizedPath(lang, '');

const useCases = await getCollection('useCases');
const year = new Date().getFullYear();
const copyright = t.footer.copyright.replace('{year}', String(year));
---

<footer class="border-t border-hairline bg-canvas">
	<Container class="grid gap-10 py-16 md:grid-cols-4">
		<div>
			<p class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
				<img src="/icon.png" alt="ScreenshotTextEditor logo" width="40" height="40" class="h-13 w-13" />
				ScreenshotTextEditor
			</p>
			<p class="mt-2 max-w-xs text-[13px] leading-relaxed text-mute">
				{t.footer.tagline}
			</p>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">{t.footer.productHeading}</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				<li><a href="/app" class="hover:text-ink">{t.footer.openEditor}</a></li>
				<li><a href={localizedPath(lang, 'pricing')} class="hover:text-ink">{t.footer.pricing}</a></li>
				<li><a href={`${home}#use-cases`} class="hover:text-ink">{t.footer.useCases}</a></li>
			</ul>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">{t.footer.useCasesHeading}</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				{
					useCases.map((useCase) => (
						<li>
							<a href={`/${useCase.id}`} class="hover:text-ink">
								{useCase.data.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<p class="font-mono text-xs font-medium uppercase tracking-wide text-faint">{t.footer.companyHeading}</p>
			<ul class="mt-3 space-y-2 text-[14px] text-body">
				<li><a href={localizedPath(lang, 'about')} class="hover:text-ink">{t.footer.about}</a></li>
				<li><a href={localizedPath(lang, 'contact')} class="hover:text-ink">{t.footer.contact}</a></li>
				<li><a href="/privacy" class="hover:text-ink">{t.footer.privacy}</a></li>
				<li><a href="/terms" class="hover:text-ink">{t.footer.terms}</a></li>
			</ul>
		</div>
	</Container>

	<div class="border-t border-hairline">
		<Container class="py-4 text-[12px] text-faint">
			{copyright}
		</Container>
	</div>
</footer>
