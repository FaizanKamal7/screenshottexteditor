---
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getTranslations, localizedPath, type TranslatableRouteKey } from '../i18n';

interface Props {
	lang?: string;
	/** The current page's translatable route key, or null if this page has no translated version. */
	routeKey?: TranslatableRouteKey | null;
}

const { lang = 'en', routeKey = null } = Astro.props;
const t = getTranslations(lang);
const home = localizedPath(lang, '');

const links = [
	{ href: `${home}#use-cases`, label: t.nav.useCases },
	{ href: localizedPath(lang, 'pricing'), label: t.nav.pricing },
	{ href: localizedPath(lang, 'about'), label: t.nav.about },
	{ href: localizedPath(lang, 'contact'), label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 [overflow-anchor:none]">
	<div
		id="site-nav"
		data-scrolled="false"
		class="mx-4 mt-4 rounded-3xl border border-hairline bg-canvas-elevated/90 shadow-sm backdrop-blur-md transition-[margin,border-radius,box-shadow,max-width] duration-500 ease-out sm:mx-auto sm:max-w-6xl data-[scrolled=true]:mx-0 data-[scrolled=true]:mt-0 data-[scrolled=true]:max-w-none data-[scrolled=true]:rounded-none data-[scrolled=true]:border-x-0 data-[scrolled=true]:border-t-0 data-[scrolled=true]:shadow-none"
	>
		<div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
			<a href={home} class="flex items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
				<img src="/icon.png" alt="ScreenshotTextEditor logo" width="44" height="44" class="h-13 w-13" />
				ScreenshotTextEditor
			</a>

			<nav class="hidden items-center gap-1 md:flex">
				{
					links.map((link) => (
						<a
							href={link.href}
							class="rounded-full px-3 py-1.5 text-[14px] text-body transition-colors hover:bg-hairline-soft hover:text-ink"
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="hidden items-center gap-2 md:flex">
				<ThemeToggle />
				<LanguageSwitcher lang={lang} routeKey={routeKey} />
				<Button href="/app" variant="primary">{t.nav.openEditor}</Button>
			</div>

			<div class="flex items-center gap-1 md:hidden">
				<ThemeToggle />
				<LanguageSwitcher lang={lang} routeKey={routeKey} />
				<details class="md:hidden">
					<summary class="list-none rounded-md border border-hairline px-2.5 py-1.5 text-[13px] text-body [&::-webkit-details-marker]:hidden">
						{t.nav.menu}
					</summary>
					<div class="absolute inset-x-0 top-[calc(100%+0.5rem)] z-20 rounded-xl border border-hairline bg-canvas-elevated px-6 py-4 shadow-sm">
						<nav class="flex flex-col gap-1">
							{
								links.map((link) => (
									<a href={link.href} class="rounded-md px-2 py-2 text-[15px] text-body hover:bg-hairline-soft hover:text-ink">
										{link.label}
									</a>
								))
							}
							<a href="/app" class="mt-2 rounded-full bg-ink px-3.5 py-2 text-center text-[15px] font-medium text-on-primary">
								{t.nav.openEditor}
							</a>
						</nav>
					</div>
				</details>
			</div>
		</div>
	</div>
</header>

<script>
	const nav = document.getElementById('site-nav');
	if (nav) {
		const updateScrolled = () => {
			const isScrolled = nav.dataset.scrolled === 'true';
			if (!isScrolled && window.scrollY > 24) {
				nav.dataset.scrolled = 'true';
			} else if (isScrolled && window.scrollY < 8) {
				nav.dataset.scrolled = 'false';
			}
		};
		updateScrolled();
		window.addEventListener('scroll', updateScrolled, { passive: true });
	}
</script>
