---
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getTranslations, localizedPath, type TranslatableRouteKey } from '../i18n';

interface Props {
	lang?: string;
	/** The current page's translatable route key, or null if this page has no translated version. */
	routeKey?: TranslatableRouteKey | null;
}

const { lang = 'en', routeKey = null } = Astro.props;
const t = getTranslations(lang);
const home = localizedPath(lang, '');

const links = [
	{ href: `${home}#use-cases`, label: t.nav.useCases },
	{ href: localizedPath(lang, 'about'), label: t.nav.about },
	{ href: localizedPath(lang, 'contact'), label: t.nav.contact },
];
---

<header class="sticky top-0 z-50 [overflow-anchor:none]">
	<div id="site-nav" data-scrolled="false" class="nav-shell">
		<div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
			<a href={home} class="flex min-w-0 shrink items-center gap-2 text-[15px] font-semibold tracking-tight text-ink">
				<img src="/icon.png" alt="ScreenshotTextEditor logo" width="44" height="44" class="h-13 w-13 shrink-0" />
				<span class="truncate">ScreenshotTextEditor</span>
			</a>

			<nav class="hidden items-center gap-1 md:flex">
				{links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
			</nav>

			<!-- One copy of the theme/language controls for every breakpoint; only the editor
			     button (desktop) and the menu (mobile) swap. -->
			<div class="flex shrink-0 items-center gap-1 md:gap-2">
				<ThemeToggle />
				<LanguageSwitcher lang={lang} routeKey={routeKey} />
				<div class="hidden md:block">
					<Button href="/app" variant="primary">{t.nav.openEditor}</Button>
				</div>
				<details class="md:hidden">
					<summary class="nav-icon-btn" aria-label={t.nav.menu}>
						<svg class="h-[18px] w-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</summary>
					<div class="nav-popover inset-x-0 top-[calc(100%+0.5rem)] rounded-xl px-6 py-4">
						<nav class="flex flex-col gap-1">
							{links.map((link) => <a href={link.href} class="nav-link rounded-md px-2 py-2 text-[15px]">{link.label}</a>)}
							<a href="/app" class="mt-2 rounded-full bg-ink px-3.5 py-2 text-center text-[15px] font-medium text-on-primary">
								{t.nav.openEditor}
							</a>
						</nav>
					</div>
				</details>
			</div>
		</div>
	</div>
</header>

<script>
	const nav = document.getElementById('site-nav');
	if (nav) {
		const updateScrolled = () => {
			const isScrolled = nav.dataset.scrolled === 'true';
			if (!isScrolled && window.scrollY > 24) {
				nav.dataset.scrolled = 'true';
			} else if (isScrolled && window.scrollY < 8) {
				nav.dataset.scrolled = 'false';
			}
		};
		updateScrolled();
		window.addEventListener('scroll', updateScrolled, { passive: true });
	}
</script>
